rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return userExists() && userData().active == true;
    }

    function isAdmin() {
      return activeUser() && userData().role == "admin";
    }

    function isTeacher() {
      return activeUser() && userData().role == "teacher";
    }

    function isStudent() {
      return activeUser() && userData().role == "student";
    }

    function canManageTargetRole(role) {
      return isAdmin() || (isTeacher() && role == "student");
    }

    function classExists(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId));
    }

    function classData(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function assignmentExists(assignmentId) {
      return exists(/databases/$(database)/documents/assignments/$(assignmentId));
    }

    function assignmentData(assignmentId) {
      return get(/databases/$(database)/documents/assignments/$(assignmentId)).data;
    }

    function managesClass(classId) {
      return isAdmin()
        || (
          isTeacher()
          && classExists(classId)
          && classData(classId).teacherId == request.auth.uid
        );
    }

    function isClassMember(classId) {
      return activeUser()
        && classExists(classId)
        && request.auth.uid in classData(classId).memberIds;
    }

    function canSubmitAssignment(assignmentId, studentId) {
      return isStudent()
        && studentId == request.auth.uid
        && assignmentExists(assignmentId)
        && request.auth.uid in assignmentData(assignmentId).studentIds;
    }

    match /users/{userId} {
      allow read: if activeUser();

      allow create: if signedIn()
        && (
          (request.auth.uid == userId && request.resource.data.active == true)
          || canManageTargetRole(request.resource.data.role)
        );

      allow update: if isAdmin()
        || (
          isTeacher()
          && resource.data.role == "student"
          && request.resource.data.role == "student"
          && request.resource.data.email == resource.data.email
        )
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.active == resource.data.active
        );

      allow delete: if false;
    }

    match /classes/{classId} {
      allow read: if isAdmin() || isClassMember(classId);

      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update, delete: if managesClass(classId);
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin()
        || managesClass(resource.data.classId)
        || (isStudent() && request.auth.uid in resource.data.studentIds);

      allow create: if managesClass(request.resource.data.classId);
      allow update: if managesClass(resource.data.classId)
        && managesClass(request.resource.data.classId);
      allow delete: if managesClass(resource.data.classId);
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || managesClass(resource.data.classId)
        || (isStudent() && request.auth.uid in resource.data.studentIds);

      allow create: if managesClass(request.resource.data.classId);
      allow update: if managesClass(resource.data.classId)
        && managesClass(request.resource.data.classId);
      allow delete: if managesClass(resource.data.classId);
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin()
        || managesClass(resource.data.classId)
        || (isStudent() && resource.data.studentId == request.auth.uid);

      allow create: if canSubmitAssignment(
        request.resource.data.assignmentId,
        request.resource.data.studentId
      );

      allow update: if isAdmin()
        || (
          canSubmitAssignment(resource.data.assignmentId, resource.data.studentId)
          && request.resource.data.assignmentId == resource.data.assignmentId
          && request.resource.data.studentId == resource.data.studentId
        );

      allow delete: if isAdmin()
        || canSubmitAssignment(resource.data.assignmentId, resource.data.studentId);
    }

    match /messages/{messageId} {
      allow read: if isAdmin()
        || (
          resource.data.chatType == "direct"
          && request.auth.uid in resource.data.participantIds
        )
        || (
          resource.data.chatType == "class"
          && request.auth.uid in resource.data.participantIds
        );

      allow create: if activeUser()
        && request.resource.data.senderId == request.auth.uid
        && (
          (
            request.resource.data.chatType == "direct"
            && request.auth.uid in request.resource.data.participantIds
          )
          || (
            request.resource.data.chatType == "class"
            && request.auth.uid in request.resource.data.participantIds
          )
        );

      allow update, delete: if false;
    }
  }
}
